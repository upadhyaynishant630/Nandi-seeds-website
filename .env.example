# =====================================================
# NANDI SEEDS - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# =====================================================

# ---------- SERVER ----------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---------- MYSQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nandi_seeds

# ---------- SMTP (outgoing email) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ---------- MAIL ROUTING ----------
MAIL_FROM_NAME=Nandi Seeds Website
MAIL_TO_SALES=sales@nandiseeds.com
MAIL_TO_CAREERS=hr@nandiseeds.com
